    "@fontsource/roboto": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
