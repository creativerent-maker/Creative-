---
import type { Locale } from '../i18n/routes';
import type { Servicio } from '../lib/content';
interface Props { locale: Locale; servicios: Servicio[]; heading?: string; headingLevel?: 'h1' | 'h2' }
const { servicios, heading, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---
<section class="section services">
  <div class="wrap">
    {heading && <H class="title">{heading}</H>}
    <ul class="grid">
      {servicios.map((s) => (
        <li class="service-card">
          <a href={s.href}>
            <span class="bar" aria-hidden="true"></span>
            <h3>{s.t.titulo}</h3>
            <p>{s.t.frase}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .title { font-size: var(--fs-xl); margin-bottom: 1.75rem; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .service-card a { display: grid; gap: .5rem; align-content: start; height: 100%; padding: 1.3rem 1.25rem 1.4rem; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; transition: border-color .15s, box-shadow .15s; }
  .service-card a:hover { border-color: var(--orange); box-shadow: 0 10px 24px -18px rgba(49,49,81,.5); }
  .bar { width: 28px; height: 4px; border-radius: 2px; background: var(--orange); }
  h3 { font-size: 1.1rem; }
  p { font-size: var(--fs-sm); color: var(--muted); line-height: 1.45; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
