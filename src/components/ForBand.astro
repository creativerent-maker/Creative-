---
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { tiposCliente } from '../lib/works';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="for" aria-labelledby="for-label">
  <div class="wrap inner">
    <h2 id="for-label" class="label">{t(locale, 'for.label')}</h2>
    <ul>{tiposCliente.map((k) => <li>{t(locale, `tipo.${k}`)}</li>)}</ul>
  </div>
</section>
<style>
  .for { background: var(--navy); color: #fff; }
  .inner { display: flex; align-items: center; gap: 1rem 2rem; padding-block: 1.4rem; flex-wrap: wrap; }
  .label { font: 700 var(--fs-xs)/1.2 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--orange-soft); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem 2rem; flex: 1; }
  li { border-left: 2px solid var(--orange); padding-left: .8rem; font-weight: 500; }
  @media (max-width: 760px) { .inner { flex-direction: column; align-items: stretch; } ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .9rem 1rem; } }
</style>
