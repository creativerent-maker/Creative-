---
import { localizedPath, type Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { contact } from '../lib/contact';
interface Props { locale: Locale }
const { locale } = Astro.props;
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY || '1x00000000000000000000AA'; // clave de pruebas de Cloudflare
const tipos = ['institucional', 'corporativo', 'congreso', 'fiesta-popular', 'otro'] as const;
const opt = `(${t(locale, 'form.opcional')})`;
---
<form id="presupuesto" class="qform" novalidate data-ok={t(locale, 'form.ok')} data-error={t(locale, 'form.error')} data-sending={t(locale, 'form.enviando')} data-required={t(locale, 'form.obligatorio')}>
  <h2>{t(locale, 'form.title')}</h2>
  <div class="grid">
    <label><span class="lt">{t(locale, 'form.nombre')}</span><input id="q-nombre" name="nombre" autocomplete="name" required maxlength="120" /></label>
    <label><span class="lt">{t(locale, 'form.organizacion')} <span class="opt">{opt}</span></span><input id="q-org" name="organizacion" autocomplete="organization" maxlength="160" /></label>
    <label><span class="lt">{t(locale, 'form.email')}</span><input id="q-email" name="email" type="email" autocomplete="email" required maxlength="160" /></label>
    <label><span class="lt">{t(locale, 'form.telefono')} <span class="opt">{opt}</span></span><input id="q-tel" name="telefono" type="tel" autocomplete="tel" maxlength="40" /></label>
    <label><span class="lt">{t(locale, 'form.tipoEvento')}</span>
      <select id="q-tipo" name="tipoEvento" required>
        {tipos.map((k) => <option value={k}>{t(locale, `form.tipo.${k}`)}</option>)}
      </select>
    </label>
    <label><span class="lt">{t(locale, 'form.fecha')} <span class="opt">{opt}</span></span><input id="q-fecha" name="fecha" type="date" /></label>
    <label><span class="lt">{t(locale, 'form.lugar')} <span class="opt">{opt}</span></span><input id="q-lugar" name="lugar" maxlength="160" /></label>
    <label><span class="lt">{t(locale, 'form.asistentes')} <span class="opt">{opt}</span></span><input id="q-asist" name="asistentes" type="number" min="1" max="1000000" inputmode="numeric" /></label>
    <label class="full"><span class="lt">{t(locale, 'form.mensaje')}</span><textarea id="q-msg" name="mensaje" rows="6" required maxlength="5000"></textarea></label>
  </div>
  <label class="check"><input id="q-priv" type="checkbox" name="privacidad" required /> <span><a href={localizedPath('privacidad', locale)}>{t(locale, 'form.privacidad')}</a></span></label>
  <div class="cf-turnstile" data-sitekey={sitekey} data-language={locale}></div>
  <button class="btn" type="submit">{t(locale, 'form.enviar')}</button>
  <p class="status" role="status" aria-live="polite"></p>
  <noscript><p>{t(locale, 'contacto.telefono')}: {contact.telefono} · {contact.email}</p></noscript>
</form>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  const form = document.getElementById('presupuesto') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('.status')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const fd = new FormData(form);
    const body = {
      ...Object.fromEntries([...fd.entries()].filter(([k]) => k !== 'cf-turnstile-response' && k !== 'privacidad')),
      privacidad: fd.get('privacidad') === 'on',
      turnstileToken: fd.get('cf-turnstile-response') ?? '',
    };
    btn.disabled = true;
    status.textContent = form.dataset.sending ?? '';
    try {
      const res = await fetch('/api/presupuesto', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
      const json = await res.json().catch(() => ({}));
      if (res.ok && json.ok) {
        form.reset();
        status.textContent = form.dataset.ok ?? '';
        status.className = 'status ok';
      } else {
        for (const k of Object.keys(json.errors ?? {})) form.querySelector(`[name="${k}"]`)?.setAttribute('aria-invalid', 'true');
        status.textContent = form.dataset.error ?? '';
        status.className = 'status err';
      }
    } catch {
      status.textContent = form.dataset.error ?? '';
      status.className = 'status err';
    } finally {
      btn.disabled = false;
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    }
  });
</script>
<style>
  .qform { display: grid; gap: 1.25rem; background: var(--surface-2); border-radius: var(--radius); padding: clamp(1.25rem, 1rem + 2vw, 2.25rem); scroll-margin-top: 1rem; }
  h2 { font-size: var(--fs-lg); }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.25rem; }
  label { display: grid; gap: .35rem; font-size: var(--fs-sm); font-weight: 500; }
  .full { grid-column: 1 / -1; }
  .opt { color: var(--muted); font-weight: 400; }
  input, select, textarea { font: 400 var(--fs-md) var(--font-body); padding: .7rem .8rem; border: 1px solid #cfcfdc; border-radius: 4px; background: #fff; color: var(--ink); width: 100%; min-height: 48px; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--orange); outline-offset: 0; border-color: var(--orange); }
  [aria-invalid='true'] { border-color: #c0262d; box-shadow: 0 0 0 1px #c0262d; }
  .check { grid-template-columns: auto 1fr; align-items: start; gap: .6rem; font-weight: 400; }
  .check input { width: 22px; height: 22px; min-height: 0; margin-top: .1rem; }
  .btn { justify-self: start; }
  .status:empty { display: none; }
  .status { font-weight: 500; }
  .status.ok { color: #1d7a3c; }
  .status.err { color: #c0262d; }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
