---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getClientes } from '../lib/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const clientes = await getClientes();
---
{clientes.length > 0 && (
  <section class="section clients" aria-labelledby="clients-title">
    <div class="wrap head">
      <h2 id="clients-title">{t(locale, 'home.clientes')}</h2>
      <button type="button" class="marquee-toggle" aria-pressed="false" data-pause={t(locale, 'clientes.pausar')} data-play={t(locale, 'clientes.reanudar')}>{t(locale, 'clientes.pausar')}</button>
    </div>
    <div class="marquee" data-marquee>
      <ul class="marquee-track">
        {clientes.map((c) => (
          <li class="logo"><Image src={c.logo} alt={c.nombre} height={64} /></li>
        ))}
        {clientes.map((c) => (
          <li class="logo" aria-hidden="true"><Image src={c.logo} alt="" height={64} /></li>
        ))}
      </ul>
    </div>
  </section>
)}
<script>
  document.querySelectorAll<HTMLButtonElement>('.marquee-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const paused = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = (paused ? btn.dataset.play : btn.dataset.pause) ?? '';
      btn.closest('section')?.querySelector('[data-marquee]')?.classList.toggle('is-paused', paused);
    });
  });
</script>
<style>
  .clients { border-top: 1px solid var(--line); }
  h2 { font-size: var(--fs-xl); }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .marquee-toggle { min-height: 40px; padding: .4rem .9rem; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: 500 var(--fs-sm) var(--font-body); color: var(--ink); cursor: pointer; }
  .marquee.is-paused .marquee-track, .marquee:focus-within .marquee-track { animation-play-state: paused; }
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .marquee-track { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; width: max-content; animation: marquee 45s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .logo { flex: none; width: 190px; height: 96px; display: grid; place-items: center; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface-2); }
  .logo :global(img) { max-height: 56px; width: auto; filter: grayscale(1); opacity: .75; }
  @keyframes marquee { to { transform: translateX(calc(-50% - .5rem)); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-toggle { display: none; }
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .marquee-track { animation: none; width: auto; flex-wrap: wrap; padding-inline: var(--gutter); justify-content: center; }
    .marquee-track .logo[aria-hidden='true'] { display: none; }
  }
</style>
